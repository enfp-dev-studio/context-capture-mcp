{
  "name": "vision-context-mcp",
  "version": "1.0.0",
  "description": "A local-first MCP server that gives your AI assistant eyes to see and understand your screen in real-time",
  "type": "module",
  "bin": {
    "vision-context-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target node",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepublishOnly": "bun run build",
    "start": "node dist/index.js"
  },
  "module": "src/index.ts",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude",
    "claude-desktop",
    "ai",
    "llm",
    "vision",
    "computer-vision",
    "screen-capture",
    "screenshot",
    "screen-monitoring",
    "local-ai",
    "privacy-first",
    "transformers",
    "developer-tools",
    "debugging",
    "testing",
    "qa",
    "ios-simulator",
    "android-emulator",
    "godot",
    "unity",
    "unreal",
    "game-development",
    "screen-recorder",
    "visual-debugging",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/vision-context-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/vision-context-mcp/issues"
  },
  "homepage": "https://github.com/yourusername/vision-context-mcp#readme",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/screenshot-desktop": "^1.15.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@arcsine/screen-recorder": "^0.2.9",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@xenova/transformers": "^2.17.2",
    "node-window-manager": "^2.2.4",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "screenshot-desktop": "^1.15.3",
    "sharp": "^0.34.5"
  }
}
